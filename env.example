# ── LLM ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── RAG ───────────────────────────────────────────────────────────
VECTOR_STORE_PATH=backend/rag/vector_store
KNOWLEDGE_BASE_PATH=backend/rag/knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_DOCS=4

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///backend/db/chatbot.db

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── ngrok ─────────────────────────────────────────────────────────
# Get your token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN= **************************************************

# ── Flask ─────────────────────────────────────────────────────────
FLASK_DEBUG=false
FLASK_PORT=5000
